{
  "name": "verimap-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.18 <25",
    "pnpm": ">=10.34 <11"
  },
  "scripts": {
    "dev": "node scripts/copy-cesium.mjs && vite",
    "build": "node scripts/copy-cesium.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings 0 .",
    "fmt": "prettier --write .",
    "fmt-check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen-types": "node scripts/gen-types.mjs"
  },
  "dependencies": {
    "cesium": "1.146.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
